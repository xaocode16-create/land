# TikTok Login Kit / Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://land-rouge-alpha.vercel.app/xaocode/tiktok/callback

# Generate a random 32-byte value and keep it only in Vercel Environment Variables.
TIKTOK_TOKEN_ENCRYPTION_KEY=

# Shared secret for protected n8n/admin requests. Never commit the real value.
N8N_INTEGRATION_SECRET=
